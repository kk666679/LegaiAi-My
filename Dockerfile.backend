# syntax=docker/dockerfile:1
#
# LAWMATE backend — Dockerfile for the npm workspaces monorepo.

FROM node:24-slim AS base
WORKDIR /app
ENV NODE_ENV=development
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

# ── 1. Manifests + scripts needed by postinstall ────────────────────────────
FROM base AS manifests
COPY package.json ./
COPY package-lock.json ./
COPY backend/package.json ./backend/
COPY packages ./packages
COPY @kk666679 ./@kk666679
# postinstall runs scripts/patch-ag-ui-core.mjs and `npm run db:generate`
COPY scripts ./scripts
COPY prisma ./prisma

# ── 2. Install workspace dependencies ───────────────────────────────────────
FROM manifests AS deps
RUN npm ci --legacy-peer-deps --include=dev --ignore-scripts

# ── 3. Run postinstall manually after source is available ───────────────────
FROM deps AS build
# The manifest stage creates /app/backend to install its workspace package.
# In the source tree, backend is a symlink to packages/backend, so remove that
# temporary directory before copying the repository tree into the image.
RUN rm -rf ./backend
COPY . .
RUN node scripts/patch-ag-ui-core.mjs
ARG DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
ENV DATABASE_URL=${DATABASE_URL}
RUN npx prisma generate --schema backend/prisma/schema.prisma

# ── 4. Runtime ──────────────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps  /app/node_modules         ./node_modules
COPY --from=deps  /app/package.json         ./package.json
COPY --from=deps  /app/package-lock.json    ./package-lock.json
COPY --from=build /app/backend              ./backend
COPY --from=build /app/packages             ./packages
COPY --from=build /app/@kk666679            ./@kk666679

EXPOSE 3001
CMD ["npx", "tsx", "backend/src/server.ts"]
