{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["court","suitNo","plaintiff","defendant","facts","causeOfAction","reliefClaimed"],
  "properties": {
    "court": {"type":"string","minLength":1},
    "suitNo": {"type":"string","minLength":1},
    "plaintiff": {
      "type":"object",
      "additionalProperties":false,
      "required":["name","description","address"],
      "properties":{
        "name":{"type":"string"},
        "description":{"type":"string"},
        "address":{"type":"string"}
      }
    },
    "defendant": {
      "type":"object",
      "additionalProperties":false,
      "required":["name","description","address"],
      "properties":{
        "name":{"type":"string"},
        "description":{"type":"string"},
        "address":{"type":"string"}
      }
    },
    "facts": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "causeOfAction": {"type":"string","minLength":1},
    "reliefClaimed": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "solicitorName": {"type":"string"},
    "solicitorRef": {"type":"string"}
  }
}

