{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["court","parties","terms","date"],
  "properties": {
    "court": {"type":"string","minLength":1},
    "parties": {
      "type":"object",
      "additionalProperties": false,
      "required":["applicant","respondent"],
      "properties":{
        "applicant":{"type":"string","minLength":1},
        "respondent":{"type":"string","minLength":1},
        "applicantAddress":{"type":"string"},
        "respondentAddress":{"type":"string"}
      }
    },
    "terms": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "date": {"type":"string","minLength":1},
    "suitNo": {"type":"string"},
    "iracIssueHint": {"type":"string"},
    "solicitorName": {"type":"string"},
    "solicitorRef": {"type":"string"}
  }
}

