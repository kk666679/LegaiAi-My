{
  "name": "@lawmate/mcp",
  "version": "1.0.0",
  "description": "LAWMATE MCP \u2014 Model Context Protocol server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "lawmate",
    "mcp",
    "model-context-protocol",
    "legal",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@lawmate/branding": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
