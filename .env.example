# ── Core ───────────────────────────────────────────────────────────────
# Public URL of this deployment (used in billing success/cancel redirects)
APP_URL=https://lawmate.example.com

# tRPC backend URL consumed by the Next.js frontend.
# Must be set at BUILD time for NEXT_PUBLIC_ vars (inlined by Next.js).
NEXT_PUBLIC_TRPC_URL=http://localhost:3001/trpc

# ── Database (PostgreSQL + pgVector) ─────────────────────────────────────
# Canonical name is DATABASE_URL. backend/src/db/index.ts also accepts, in
# order: ORM_DATABASE_URL, ORM_PRISMA_DATABASE_URL, ORM_POSTGRES_URL (used by
# Prisma Accelerate / Vercel integrations). Set only one.
DATABASE_URL=postgresql://lawmate:lawmate123@postgres:5432/lawmate?schema=public

# ── Redis (BullMQ) ───────────────────────────────────────────────────────
# Canonical name is REDIS_URL. REDIS_HOST + REDIS_PORT are accepted as a
# fallback for docker-compose setups where a single URL is awkward.
REDIS_URL=redis://redis:6379

# ── Backend HTTP ─────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=warn

# ── Auth / sessions (CHANGE THESE IN PRODUCTION — min 32 random chars) ────
SESSION_SECRET=change-me-at-least-32-random-characters-long

# ── LLM / embeddings ─────────────────────────────────────────────────────
# Local Ollama (default). For production scale, set a cloud provider instead.
# lib/ai.ts routes by model-id prefix:
#   meta-llama/* | mistralai/* | deepseek-ai/*  -> DeepInfra (DEEPINFRA_API_KEY)
#   anything else                                -> OpenAI       (OPENAI_API_KEY)
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1
LLM_MODEL_FALLBACK=llama3.2:1b
EMBED_MODEL=mxbai-embed-large

# Optional: cloud LLM (must NOT receive confidential/privileged client data)
OPENAI_API_KEY=

# OpenRouter (https://openrouter.ai). Routes to 200+ models via OpenAI-compatible API.
# Set OPENROUTER_API_KEY to enable. Default base is https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=
# Optional attribution headers (recommended by OpenRouter for app ranking)
OPENROUTER_APP_URL=https://lawmate.example.com
OPENROUTER_APP_NAME=LawMate

# DeepInfra (used by lib/ai.ts when LLM_MODEL matches a DeepInfra model id,
# e.g. meta-llama/Meta-Llama-3.1-70B-Instruct). Set DEEPINFRA_API_KEY to enable.
DEEPINFRA_API_KEY=

# ── Payments (Xendit / 2C2P) — fill for live billing ─────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
TWOC2P_MERCHANT_ID=
TWOC2P_SECRET_KEY=
TWOC2P_WEBHOOK_TOKEN=

# ── Messaging channels (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
WHATSAPP_ENABLED=false

# ── Tuning ───────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.6
ALERT_DELAY_HOURS=4

# ── Vercel Sandbox (isolated microVMs for untrusted code) ──────────────────
# Authenticated automatically via VERCEL_OIDC_TOKEN on Vercel deployments.
# For local dev, populate VERCEL_OIDC_TOKEN via `vercel env pull`.
# Optional override of the Vercel Sandbox API endpoint.
VERCEL_SANDBOX_API_URL=
# Default image for legal sandboxes (Node 24 LTS).
VERCEL_SANDBOX_IMAGE=vercel/sandbox/universal
# Default session timeout in ms (5 min). Hobby max 45 min, Pro/Ent up to 24h.
VERCEL_SANDBOX_TIMEOUT_MS=300000
# Default egress policy. Use 'deny-all' for strictly isolated runs.
VERCEL_SANDBOX_NETWORK_POLICY=allow-all
# Optional default region (e.g. iad1, sin1). Falls back to project default.
VERCEL_SANDBOX_REGION=
# vCPUs per sandbox (memory auto-scales to 2048 MB / vCPU).
VERCEL_SANDBOX_VCPUS=2
