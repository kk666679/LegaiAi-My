{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [
      { "name": "next" }
    ]
  },
  "exclude": ["backend/**", "node_modules", ".next", "dist", "build"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "types/**/*.d.ts",
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "hooks/**/*",
    "clients.ts",
    "types/**/*"
  ]
}