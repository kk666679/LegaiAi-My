{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "pretty": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/backend/*": [
        "./backend/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/components/ui/*": [
        "./components/ui/*"
      ],
      "@/components/ai/*": [
        "./components/ai/*"
      ],
      "@/components/ai-elements/*": [
        "./components/ai-elements/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/lib/utils/*": [
        "./lib/utils/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/hooks/use*": [
        "./hooks/use*.ts"
      ],
      "@/types/*": [
        "./types/*"
      ],
      "@/utils/*": [
        "./utils/*"
      ],
      "@/config/*": [
        "./config/*"
      ],
      "@/constants/*": [
        "./constants/*"
      ],
      "@/services/*": [
        "./services/*"
      ],
      "@/workers/*": [
        "./workers/*"
      ],
      "@/queues/*": [
        "./src/queues/*"
      ],
      "@/prisma/*": [
        "./prisma/*"
      ],
      "@/validators/*": [
        "./validators/*"
      ],
      "@/public/*": [
        "./public/*"
      ],
      "@ui": [
        "./components/ui/index.ts"
      ],
      "@ai": [
        "./components/ai/index.ts"
      ],
      "@ai-elements": [
        "./components/ai-elements/index.ts"
      ],
      "~/*": [
        "./*"
      ],
      "~backend/*": [
        "./backend/*"
      ],
      "~components/*": [
        "./components/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@typescript-eslint/eslint-plugin"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "types/**/*.d.ts",
    "workers/**/*.ts",
    "workers/**/*.js",
    "queues/**/*.ts",
    "queues/**/*.js",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "backend/**/*.ts",
    "backend/**/*.tsx",
    "backend/**/*.js",
    "backend/**/*.jsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": [
    "node_modules",
    ".openclaw/**",
    "dist",
    "build",
    ".next",
    "out",
    "coverage",
    "**/*.d.tsx",
    "**/*.bak",
    "**/*.old",
    "prisma/generated/**",
    "types/generated/**",
    "tmp",
    "temp",
    ".cache",
    ".vercel",
    ".docker",
    "docker",
    "logs",
    "**/*.log",
    ".env*",
    ".env.local",
    "!.env.example",
    "backend/schemas",
    "packages/**"
  ],
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": [
      "**/node_modules",
      "**/.next",
      "**/.openclaw"
    ]
  }
}